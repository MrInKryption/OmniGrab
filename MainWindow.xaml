<ui:FluentWindow x:Class="OmniGrab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:OmniGrab"
        mc:Ignorable="d"
        Title="OmniGrab - Universal Video &amp; Audio Downloader"
        Height="800" Width="1060"
        MinHeight="650" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="OmniGrab - Universal Video &amp; Audio Downloader"
            Foreground="#E6EDF3" />

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,20">
            <StackPanel>

                <!-- Engine Health & Banner Card -->
                <Border Background="#161B22" CornerRadius="8" BorderBrush="#30363D" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EngineStatusDot" Width="10" Height="10" Fill="#2ECC71" Margin="0,0,10,0" />
                            <TextBlock x:Name="EngineStatusText" Text="Core Engine Ready (yt-dlp + FFmpeg Auto-Muxing)" 
                                       Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>

                        <ui:Button x:Name="BtnUpdateEngine" Grid.Column="1" 
                                   Content="Check / Update Engine" 
                                   Appearance="Secondary"
                                   Click="BtnUpdateEngine_Click" />
                    </Grid>
                </Border>

                <!-- Input Card -->
                <Border Background="#161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Paste Video Link" FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,4" />
                        <TextBlock Text="Works with YouTube, TikTok, Twitch, Reddit, X/Twitter, Instagram, Vimeo, and 1,800+ sites." 
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="TxtUrl" Grid.Column="0" 
                                        PlaceholderText="https://www.youtube.com/watch?v=... or TikTok, Twitch, Reddit link..." 
                                        FontSize="14"
                                        Padding="10,8"
                                        TextChanged="TxtUrl_TextChanged"
                                        KeyDown="TxtUrl_KeyDown" />

                            <ui:Button x:Name="BtnPaste" Grid.Column="1" 
                                       Content="📋 Paste" 
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Click="BtnPaste_Click" />

                            <ui:Button x:Name="BtnFetchInfo" Grid.Column="2" 
                                       Content="🔍 Inspect Link" 
                                       Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Click="BtnFetchInfo_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Metadata Preview Card (Shows when inspected or pasting) -->
                <Border x:Name="CardPreview" Background="#161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Background="#0D1117" Height="125">
                            <Image x:Name="ImgThumbnail" Stretch="UniformToFill" />
                        </Border>

                        <!-- Video Details -->
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border x:Name="BadgePlatform" Background="#1F6FEB" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtPlatform" Text="YouTube" FontWeight="Bold" FontSize="11" Foreground="White" />
                                </Border>
                                <Border Background="#21262D" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtDuration" Text="00:00" FontSize="11" Foreground="#C9D1D9" />
                                </Border>
                                <Border Background="#21262D" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="TxtUploader" Text="Channel" FontSize="11" Foreground="#C9D1D9" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="TxtTitle" Text="Video Title Preview" 
                                       FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" 
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Download Options & Actions Card -->
                <Border Background="#161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Format Preset Selection -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Download Format &amp; Quality" FontSize="13" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbQuality" SelectedIndex="0" Padding="10,6">
                                    <ComboBoxItem Content="🌟 Best Available Quality (Auto-Merged MP4)" />
                                    <ComboBoxItem Content="🎬 1080p Full HD (Auto-Merged MP4)" />
                                    <ComboBoxItem Content="📺 720p HD (Auto-Merged MP4)" />
                                    <ComboBoxItem Content="🎵 Audio Only - MP3 (High Quality)" />
                                    <ComboBoxItem Content="🎧 Audio Only - M4A / AAC" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Download Folder Selection -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Save Folder" FontSize="13" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox x:Name="TxtDownloadFolder" Grid.Column="0" IsReadOnly="True" />
                                    <ui:Button x:Name="BtnChangeFolder" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" 
                                               Appearance="Secondary" Click="BtnChangeFolder_Click" />
                                    <ui:Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📂 Open" Margin="8,0,0,0" 
                                               Appearance="Secondary" Click="BtnOpenFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#21262D" Margin="0,0,0,14" />

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtInfoHint" Text="Audio and video tracks are automatically combined into a single file with zero loss." 
                                       FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button x:Name="BtnCancel" Content="⏹️ Cancel" 
                                           Appearance="Danger" IsEnabled="False" Margin="0,0,10,0"
                                           Click="BtnCancel_Click" />

                                <ui:Button x:Name="BtnDownload" Content="⬇️ Download Media" 
                                           Appearance="Primary" FontWeight="Bold" FontSize="14" Padding="20,10"
                                           Click="BtnDownload_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active Download Progress Card -->
                <Border x:Name="CardProgress" Background="#161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtProgressStatus" Text="Downloading..." FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" />
                            <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="0%" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" />
                        </Grid>

                        <ProgressBar x:Name="ProgressBarDownload" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#238636" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtSpeed" Text="Speed: -- MB/s" FontSize="12" Foreground="#8B949E" />
                            <TextBlock x:Name="TxtEta" Grid.Column="2" Text="ETA: --" FontSize="12" Foreground="#8B949E" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Completed Downloads History -->
                <Border Background="#161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Session Downloads" FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            <ui:Button x:Name="BtnClearHistory" Grid.Column="1" Content="Clear" Appearance="Secondary" Click="BtnClearHistory_Click" />
                        </Grid>

                        <ItemsControl x:Name="ListDownloads">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D1117" CornerRadius="6" BorderBrush="#21262D" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Platform}" Foreground="#58A6FF" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" />
                                                    <TextBlock Text="•" Foreground="#484F58" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Quality}" Foreground="#8B949E" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="•" Foreground="#484F58" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2ECC71" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>

                                            <ui:Button Grid.Column="1" Content="▶️ Play" Margin="8,0,0,0" Appearance="Secondary" 
                                                       Tag="{Binding DestinationFile}" Click="BtnPlayVideo_Click" />
                                            <ui:Button Grid.Column="2" Content="📂 Show" Margin="8,0,0,0" Appearance="Secondary" 
                                                       Tag="{Binding DestinationFile}" Click="BtnShowFile_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtNoDownloads" Text="No downloads in this session yet." 
                                   Foreground="#484F58" FontSize="13" HorizontalAlignment="Center" Margin="0,8" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#090D13" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFooterStatus" Text="Ready for next download." Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="OmniGrab Native v1.0 • .NET 8 WPF" Foreground="#484F58" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
